  "osm_queries": [
    {
      "feature": "power=substation",
      "description": "All mapped electrical substations",
      "expected_count": 600
    },
    {
      "feature": "power=sub_station",
      "description": "Alternative tagging for substations",
      "expected_count": 100
    },
    {
      "feature": "power=line",
      "description": "Overhead transmission lines",
      "expected_count": "variable"
    },
    {
      "feature": "power=cable",
      "description": "Underground/submarine cables",
      "expected_count": "variable"
    }
  ],
  "voltage_filter": {
    "transmission_kv": [400, 220, 110],
    "distribution_kv": [66, 33, 11],
    "hv_threshold_kv": 110,
    "mv_threshold_kv": 11,
    "include_unknowns": true,
    "note": "HV (≥110kV), MV (11-109kV), LV (<11kV)"
  },
  "target_statistics": {
    "total_substations": 11500,
    "hv_substations": 170,
    "mv_substations": 3500,
    "lv_substations": 7830,
    "transmission_lines_km": 15000,
    "distribution_lines_km": 180000
