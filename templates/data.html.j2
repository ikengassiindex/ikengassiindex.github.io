{# templates/data.html.j2 — Phase 3 Level C template for data.html
   Generated by scripts/build_pages.py from this template + templates/configs/<slug>.yaml.
   Output: <slug>/data.html (39 files, one per country).

   Variables consumed:
     - slug, fleet_count, admin.level_label_singular
     - descriptions.data
     - data.country_adjective    (e.g., "Slovenian"); used for Layer E label
     - data.layer_e_extended     (bool, append " + Energy Policy" to layer E if true)
     - data.source_registry_count (e.g., "18+", "30+", "30")
     - data.data_layers[]        (11 entries: {code, vars, sources})

   Reserved DOM IDs (data-sections.js compatibility — DO NOT CHANGE):
     #data-subs, #data-subs-sub, #dl-full, #dl-full-info, #dl-summary, #dl-geo,
     #dl-formula, #data-source-grid, #engine-fns, #schema-block
#}
<!DOCTYPE html>
<html lang="en">
{% set page_title = "SSI Index — Data & Download" %}
{% set page_description = descriptions.data %}
{% set page_specific_styles = "" %}
{% include "_base/head.j2" %}
<body>
{% set page = "data" %}
{% include "_base/page_scripts.j2" %}

{# Layer metadata — uniform code/color/domain/status. Per-country: vars + sources. Layer E label has adjective. #}
{% set layer_meta = [
  {'code': 'A',   'color': 'var(--crimson)', 'domain': 'SSI v4.0.2 Resilience',  'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'B.1', 'color': 'var(--sage)',    'domain': 'Grid Telemetry: Open',   'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'B.2', 'color': 'var(--sage)',    'domain': 'Grid Telemetry: Proxy', 'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'B.3', 'color': 'var(--sage)',    'domain': 'Grid Telemetry: Fuzzy', 'badge_cls': 'medium', 'status': 'FUZZY'},
  {'code': 'C',   'color': '#a67cff',        'domain': 'Socio-Economic',         'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'D',   'color': '#ff8c42',        'domain': 'Environmental Hazards',  'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'E',   'color': '#3b9eff',        'domain': '__layer_e__',            'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'F',   'color': 'var(--sage)',    'domain': 'Network Transitions',    'badge_cls': 'medium', 'status': 'BAYESIAN'},
  {'code': 'G',   'color': '#22d3ee',        'domain': 'Modifier Inputs',        'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'H',   'color': '#e67e22',        'domain': 'Network & Topology',     'badge_cls': 'low',    'status': 'LIVE'},
  {'code': 'I',   'color': '#8e44ad',        'domain': 'Output Scores',          'badge_cls': 'low',    'status': 'LIVE'},
] %}
{% set layer_e_label = data.country_adjective ~ ' Open Data' ~ (' + Energy Policy' if data.layer_e_extended else '') %}

{% set kpi_count = data.kpi_sources_count | default('30+') %}

<main class="page-shell">
  <div class="page-header animate-in">
{% if data.h1_html is defined and data.h1_html %}
    <h1>{{ data.h1_html | safe }}</h1>
{% else %}
    <h1>Data &amp; Download</h1>
{% endif %}
{% if data.subheader_html is defined and data.subheader_html %}
    <p>{{ data.subheader_html | safe }}</p>
{% else %}
    <p>All {{ kpi_count }} data sources are public, free, and independently verifiable. Download the full SSI dataset or explore source documentation. v4.0.2 &mdash; 95 variables, {{ fleet_count | thousands }} substations.</p>
{% endif %}
  </div>

  <!-- Data Status -->
  <div class="kpi-grid animate-in delay-1" style="margin-bottom:32px">
    <div class="kpi-card">
      <div class="kpi-label">Total Variables</div>
      <div class="kpi-value" style="color:var(--ink)">95</div>
      <div class="kpi-sub">Across 11 data layers</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Data Sources</div>
      <div class="kpi-value" style="color:var(--bronze)">{{ kpi_count }}</div>
      <div class="kpi-sub">All verified &amp; public</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Substations</div>
      <div class="kpi-value" style="color:var(--sage)" id="data-subs">&mdash;</div>
      <div class="kpi-sub" id="data-subs-sub">Loading&hellip;</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Max Frequency</div>
      <div class="kpi-value" style="color:var(--terracotta)">{{ data.kpi_max_frequency | default('Weekly') }}</div>
      <div class="kpi-sub">Layer B proxy/fuzzy vars</div>
    </div>
  </div>

  <!-- Download Section -->
  <div class="card animate-in delay-2" style="margin-bottom:32px">
    <div class="card-header">
      <h3>Download SSI Dataset</h3>
      <span class="label-xs">Latest fleet run</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:8px">
      <div id="dl-full" class="dl-card" style="padding:16px;border:1px solid var(--card-border);border-radius:var(--radius-sm);cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--terracotta)'" onmouseout="this.style.borderColor='var(--card-border)'">
        <div style="font-size:22px;margin-bottom:6px">📊</div>
        <div style="font-weight:500;font-size:14px;margin-bottom:2px">Full Dataset (PDF)</div>
        <div style="font-size:12px;color:var(--warm-grey)" id="dl-full-info">&mdash; substations &middot; all fields</div>
      </div>
      <div id="dl-summary" class="dl-card" style="padding:16px;border:1px solid var(--card-border);border-radius:var(--radius-sm);cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--terracotta)'" onmouseout="this.style.borderColor='var(--card-border)'">
        <div style="font-size:22px;margin-bottom:6px">📋</div>
        <div style="font-weight:500;font-size:14px;margin-bottom:2px">Summary Report (PDF)</div>
        <div style="font-size:12px;color:var(--warm-grey)">R_median, band, components, CI</div>
      </div>
      <div id="dl-geo" class="dl-card" style="padding:16px;border:1px solid var(--card-border);border-radius:var(--radius-sm);cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--terracotta)'" onmouseout="this.style.borderColor='var(--card-border)'">
        <div style="font-size:22px;margin-bottom:6px">🗺️</div>
        <div style="font-weight:500;font-size:14px;margin-bottom:2px">Geographic Data (PDF)</div>
        <div style="font-size:12px;color:var(--warm-grey)">{{ data.geo_label | default(admin.level_label_singular) }} coordinates + SSI scores</div>
      </div>
      <div id="dl-formula" class="dl-card" style="padding:16px;border:1px solid var(--card-border);border-radius:var(--radius-sm);cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--terracotta)'" onmouseout="this.style.borderColor='var(--card-border)'">
        <div style="font-size:22px;margin-bottom:6px">📐</div>
        <div style="font-weight:500;font-size:14px;margin-bottom:2px">Formula Construct (PDF)</div>
        <div style="font-size:12px;color:var(--warm-grey)">Complete v4.0.2 technical reference</div>
      </div>
    </div>
  </div>

  <!-- Data Layers -->
  <div class="card animate-in" style="margin-bottom:32px">
    <div class="card-header">
      <h3>Data Layers</h3>
      <span class="label-xs">11 layers &middot; 95 variables</span>
    </div>
    <table class="data-table" style="margin-top:4px">
      <thead>
        <tr>
          <th>Layer</th>
          <th>Domain</th>
          <th style="text-align:right">Variables</th>
          <th>Status</th>
          <th>Key Sources</th>
        </tr>
      </thead>
      <tbody>
{% for layer in layer_meta %}
{% set src = data.data_layers[loop.index0] %}
        <tr>
          <td style="font-weight:600;color:{{ layer.color }}">{{ layer.code }}</td>
          <td>{% if layer.domain == '__layer_e__' %}{{ layer_e_label }}{% else %}{{ layer.domain }}{% endif %}</td>
          <td class="num">{{ src.vars }}</td>
          <td><span class="band-badge {{ layer.badge_cls }}" style="font-size:10px">{{ layer.status }}</span></td>
          <td style="font-size:12px">{{ src.sources }}</td>
        </tr>
{% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Source Registry (all 30+, rendered from metadata) -->
  <div class="card animate-in" style="margin-bottom:32px">
    <div class="card-header">
      <h3>Data Source Registry</h3>
      <span class="label-xs">{{ data.source_registry_count }} verified &middot; all free &amp; public</span>
    </div>
    <div class="source-grid" style="margin-top:12px" id="data-source-grid"></div>
  </div>

  <!-- Engine Info -->
  <div class="card animate-in" style="margin-bottom:32px">
    <div class="card-header">
      <h3>SSI Engine</h3>
      <span class="label-xs">Client-side formula implementation</span>
    </div>
    <p style="font-size:13px;line-height:1.7;margin-bottom:12px">
      The SSI v4.0.2 calculation engine is implemented in <code>ssi-engine.js</code> and runs entirely in the browser. It exposes the complete formula construct: 6 component weights, 20 metric intra-weights, all 6 modifier functions (R2 adaptive IRI, R3 consequence sigmoid, R4 graph criticality, R6a restoration speed, R6b network topology, R7 digital readiness), T1 DER stress composite, normalisation methods, soft-clip overflow compression, and a client-side Monte Carlo simulation (1,000 iterations for browser performance).
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px">
      <div style="padding:10px;background:var(--cream);border-radius:var(--radius-sm);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--ink)" id="engine-fns">&mdash;</div>
        <div style="font-size:10px;color:var(--warm-grey)">Public API functions</div>
      </div>
      <div style="padding:10px;background:var(--cream);border-radius:var(--radius-sm);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--ink)">20</div>
        <div style="font-size:10px;color:var(--warm-grey)">Global weight entries</div>
      </div>
      <div style="padding:10px;background:var(--cream);border-radius:var(--radius-sm);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--ink)">6</div>
        <div style="font-size:10px;color:var(--warm-grey)">Modifier functions</div>
      </div>
      <div style="padding:10px;background:var(--cream);border-radius:var(--radius-sm);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--ink)">1,000</div>
        <div style="font-size:10px;color:var(--warm-grey)">MC iterations (browser)</div>
      </div>
    </div>
  </div>

  <!-- API / Schema -->
  <div class="card animate-in">
    <div class="card-header">
      <h3>Output Schema</h3>
      <span class="label-xs">JSON per substation</span>
    </div>
    <div class="formula-block" id="schema-block" style="font-size:12px;line-height:1.6">
      Loading live sample&hellip;
    </div>
  </div>
</main>

<!-- jsPDF + autotable for the 4 PDF download buttons -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

{% set section_module_name = "data-sections.js" %}
{% include "_base/thin_shell_footer.j2" %}
</body>
</html>
