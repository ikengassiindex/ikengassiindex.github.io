{# templates/intelligence.html.j2 — Phase 3 Level C SHELL-ONLY template for intelligence.html
   Generated by scripts/build_pages.py from this template + templates/configs/<slug>.yaml +
   templates/partials/intelligence/<slug>.html (per-country body partial).

   ARCHITECTURE DECISION (S110.C-6): intelligence.html is the highest-variance page in the cohort
   (412-620 lines, ~80% per-country editorial narrative). Templating the full body via override
   fields would require encoding ~500 lines of HTML per country in YAML — not a win. Instead:

     * This template = SHELL ONLY (head + body-top scripts + per-country partial include).
     * Body content (full <main>...</main> + <footer> + thin-shell-footer-scripts + edition
       auto-patcher) lives in templates/partials/intelligence/<slug>.html, extracted verbatim
       from each country's live intelligence.html via extract_intelligence_configs.py.
     * Per-country YAML stores `intelligence.title` + `anchor_year`/`anchor_month` for posterity.

   This keeps each country in full editorial control of their narrative (Section D deep-dives,
   Section E SAIDI context, etc.) while giving the cohort unified head/title/cache-busters/
   body-top script loading.

   The thin-shell footer scripts + edition auto-patcher are inside the partial (not the shell)
   because each country's auto-patcher uses different anchor month/year parameters. Templating
   the patcher would mean parameterizing ~30 lines of JS body per country — fragile. Keeping
   it in the partial preserves zero-regression migration.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if intelligence.description is defined and intelligence.description %}<meta name="description" content="{{ intelligence.description }}">
{% endif %}<title>{{ intelligence.title | default('SSI Monthly Intelligence — Edition 01') }}</title>
<link rel="stylesheet" href="../style.css?v={{ '../style.css' | cb }}">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
{% if intelligence.head_style is defined and intelligence.head_style %}<style>
{{ intelligence.head_style | safe }}
</style>
{% endif %}</head>
<body>
<script src="../nav.js?v={{ '../nav.js' | cb }}"></script>
<script src="ssi-metadata.js?v={{ (slug + '/ssi-metadata.js') | cb }}"></script>
<script src="../intelligence/intelligence-loader.js" data-country="{{ slug }}"></script>
<script>
// Config-ready bridge: SSI_EDITION available for all inline scripts
window.SSI_EDITION = window.SSI_EDITION || null;
document.addEventListener("ssi-config-ready", function(e) {
  if (e.detail) { window.SSI_EDITION = e.detail; }
});
</script>
<script>renderNav('intelligence');</script>

{# ━━━ PER-COUNTRY BODY: <main>...</main> + <footer> + thin-shell scripts + edition patcher ━━━ #}
{% include 'partials/intelligence/' + slug + '.html' %}

</body>
</html>
