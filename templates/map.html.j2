{# templates/map.html.j2 — Phase 3 Level C template for map.html
   Generated by scripts/build_pages.py from this template + templates/configs/<slug>.yaml.
   Output: <slug>/map.html (39 files, one per country).

   Variables consumed from config:
     - slug, country_name, country_possessive, fleet_count
     - admin.count, admin.level_label_singular, admin.level_label_plural

   Reserved DOM IDs (renderer.js compatibility — DO NOT CHANGE):
     - #ssi-map-canvas, #map-tooltip, #map-stats, #detail-panel
     - #filter-band, #filter-region, #filter-voltage, #filter-component, #filter-search
     - #zoomIn, #zoomOut, #zoomFit, #btn-breakdown
#}
<!DOCTYPE html>
<html lang="en">
{% set page_title = "SSI Index — Map Explorer" %}
{% set page_description = descriptions.map %}
{% set page_specific_styles %}{% include "_partials/map_styles.j2" %}{% endset %}
{% include "_base/head.j2" %}
<body>
{% set page = "map" %}
{% include "_base/page_scripts.j2" %}

<main class="page-shell" style="max-width:1440px">
  <div class="page-header animate-in">
    <h1>Map Explorer</h1>
    <p>Explore {{ fleet_count | thousands }} substations across {{ country_possessive }} transmission and distribution grid. Click to inspect scores, components, and modifiers.</p>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar animate-in delay-1">
    <label>Band</label>
    <select id="filter-band">
      <option value="all">All Bands</option>
      <option value="Low">Low (0.00&ndash;0.25)</option>
      <option value="Medium">Medium (0.25&ndash;0.50)</option>
      <option value="High">High (0.50&ndash;0.75)</option>
      <option value="Critical">Critical (0.75&ndash;1.00)</option>
    </select>
    <label>{{ admin.level_label_singular }}</label>
    <select id="filter-region">
      <option value="all">All {{ admin.level_label_plural }}</option>
    </select>
    <label>Power Voltage</label>
    <select id="filter-voltage">
      <option value="all">All Voltages</option>
{% for opt in map.voltage_filter_options %}      <option value="{{ opt.value }}">{{ opt.label }}</option>
{% endfor %}    </select>
    <label>Component Focus</label>
    <select id="filter-component">
      <option value="overall">Overall R Score</option>
      <option value="C">C &mdash; Continuity</option>
      <option value="V">V &mdash; Voltage Quality</option>
      <option value="I">I &mdash; Infrastructure</option>
      <option value="E">E &mdash; Economic</option>
      <option value="S">S &mdash; Saturation</option>
      <option value="T">T &mdash; Energy Transition</option>
    </select>
    <input type="search" id="filter-search" placeholder="Search substation&hellip;" style="margin-left:auto;width:180px">
  </div>

  <!-- Map + Detail Panel -->
  <div class="map-layout animate-in delay-2" style="display:grid;grid-template-columns:1fr 360px;gap:20px">
    <!-- Map -->
    <div class="card" style="padding:0;overflow:hidden">
      <div class="map-container">
        <canvas id="ssi-map-canvas" role="img" aria-label="Interactive map of {{ country_possessive }} electrical grid showing substations colored by SSI resilience score. Use mouse to pan and zoom, click substations for details."></canvas>
        <div id="map-tooltip"></div>

        <div class="map-legend">
          <h4>SSI Band</h4>
          <div class="map-legend-item"><div class="band-dot low"></div> Low (0.00&ndash;0.25)</div>
          <div class="map-legend-item"><div class="band-dot medium"></div> Medium (0.25&ndash;0.50)</div>
          <div class="map-legend-item"><div class="band-dot high"></div> High (0.50&ndash;0.75)</div>
          <div class="map-legend-item"><div class="band-dot critical"></div> Critical (0.75&ndash;1.00)</div>
          <div style="margin-top:6px;padding-top:6px;border-top:1px solid rgba(44,36,32,0.08);font-size:10px;color:var(--warm-grey);line-height:1.5">
            Scroll to zoom &middot; Drag to pan<br>Click substation to inspect
          </div>
        </div>

        <div class="map-zoom">
          <button id="zoomIn" title="Zoom in">+</button>
          <button id="zoomOut" title="Zoom out">&minus;</button>
          <button id="zoomFit" title="Fit {{ country_name }}" style="font-size:13px">&#10256;</button>
        </div>

        <div class="map-stats" id="map-stats">
          Loading data&hellip;
        </div>
      </div>
    </div>

    <!-- Detail Panel -->
    <div class="detail-scroll" id="detail-panel">
      <!-- Populated by map.js on click -->
    </div>
  </div>
</main>

<!-- ═══════════════════════════════════════════════════════════
     MAP ENGINE — owned by map.js (canvas renderer · auto-fit ·
     fleet_summary canonicalisation · filter wiring · detail panel).
     SSIMap.init is invoked from inside map-sections.js once
     CountryRenderer has loaded + normalised ssi-data.json + the
     per-country config — keeping the map subsystem decoupled from
     the data pipeline and centralising init options in one place.
     ═══════════════════════════════════════════════════════════ -->
{% set additional_pre_renderer_scripts = ["../map.js"] %}
{% set section_module_name = "map-sections.js" %}
{% include "_base/thin_shell_footer.j2" %}
</body>
</html>
