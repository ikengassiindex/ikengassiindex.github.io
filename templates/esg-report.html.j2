{# templates/esg-report.html.j2 — Phase 3 Level C template for esg-report.html
   Generated by scripts/build_pages.py from this template + templates/configs/<slug>.yaml.
   Output: <slug>/esg-report.html (38 files; greenland excluded per Lesson 9 bespoke-defer).

   Variables consumed:
     - slug
     - esg_report.edition_badge       ← .label-xs preamble (verbatim from source)
     - esg_report.flag_emoji          ← H1 flag span content
     - esg_report.h1_suffix           ← optional H1 suffix (none in cohort — Greenland deferred)
     - esg_report.badge_style         ← optional inline-style attrs (sage color etc.)

   NOTE: esg-report.html has its own <head> structure (fonts, Chart.js, esg-report.css)
   and body-script structure (nav.js, esg-helpers.js, intelligence-loader.js) that differ
   from the cohort-shared head.j2 + page_scripts.j2 — so they're inlined here.

   The hard-coded `?v=500` cache-busters on esg-report.css and esg-helpers.js are PRE-EXISTING
   and tracked as #750. We preserve them verbatim to keep S110.C-5 a no-regression migration.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ esg_report.title | default('SSI Index — ESG Report') }}</title>
<link rel="stylesheet" href="../style.css?v={{ '../style.css' | cb }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" defer></script>
<link rel="stylesheet" href="../esg-report.css?v={{ '../esg-report.css' | cb }}">
</head>
<body>
<script src="../nav.js?v={{ '../nav.js' | cb }}"></script>
<script src="../esg-helpers.js?v={{ '../esg-helpers.js' | cb }}"></script>
<script src="ssi-metadata.js?v={{ (slug + '/ssi-metadata.js') | cb }}"></script>
<script src="../intelligence/intelligence-loader.js?v={{ '../intelligence/intelligence-loader.js' | cb }}" data-country="{{ slug }}" id="ssi-esg-page"></script>
<script>renderNav('esg-report');</script>

<!-- ═══ Page Shell ═══ -->
<div class="page-shell">

  <!-- ── Header ── -->
  <div class="page-header">
    <div class="label-xs"{% if esg_report.badge_style is defined and esg_report.badge_style %} style="{{ esg_report.badge_style }}"{% else %} style="margin-bottom:6px;"{% endif %}>{{ esg_report.edition_badge | default('ANNUAL ESG DISCLOSURE — REPORTING PERIOD 2025') | safe }}</div>
    <h1><span style="font-size:0.75em;vertical-align:middle;margin-right:8px">{{ esg_report.flag_emoji | default('') }}</span>Substation ESG Report{% if esg_report.h1_suffix is defined and esg_report.h1_suffix %} {{ esg_report.h1_suffix | safe }}{% endif %}</h1>
    <p>Substation-level Environmental, Social, and Governance assessment aligned to CSRD/ESRS, EU Taxonomy, TCFD, SFDR, and UN PRI frameworks. Updated annually via the SSI Index scoring engine.</p>
  </div>

  <!-- ── Substation Identity KPIs ── -->
  <div class="kpi-grid" id="kpiGrid" style="margin-bottom:32px;"></div>

  <!-- ══════════════════════════════════════════════════════════
       MOD 1: COMPONENT BAR CHART (C/V/I/E/S/T fingerprint)
       ══════════════════════════════════════════════════════════ -->
  <div class="section-block component-bar-wrap">
    <div class="section-header">
      <div class="section-title-group">
        <h2>Component Fingerprint</h2>
        <div class="section-sub">Six-component weighted decomposition of the SSI composite score &mdash; the substation's structural risk profile</div>
      </div>
    </div>
    <div class="card">
      <div class="grid-2">
        <div>
          <div class="label-sm" style="margin-bottom:8px;">Weighted Contribution to R<sub>base</sub></div>
          <div class="component-bar" id="componentBar"></div>
          <div class="component-legend" id="componentLegend"></div>
        </div>
        <div>
          <canvas id="componentChart" height="180"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       MOD 2: MARKOV STEADY-STATE DIAGRAM
       ══════════════════════════════════════════════════════════ -->
  <div class="section-block">
    <div class="section-header">
      <div class="section-title-group">
        <h2>Markov Degradation Profile</h2>
        <div class="section-sub">CIGRE TB 761 five-state condition model &mdash; steady-state probability distribution and expected time to criticality</div>
      </div>
    </div>
    <div class="card">
      <div class="grid-2">
        <div>
          <div class="label-sm" style="margin-bottom:8px;">Steady-State Distribution</div>
          <div class="markov-diagram" id="markovDiagram"></div>
          <div style="margin-top:12px; font-size:12px; color:var(--warm-grey);">
            Markov 5-state model calibrated from CIGRE Technical Brochure 761 (2019). States represent asset condition from new/good through critical. Steady-state probabilities indicate the long-run proportion of time the asset spends in each condition state given current operating environment.
          </div>
        </div>
        <div>
          <div class="kpi-grid" style="grid-template-columns: 1fr 1fr; margin-bottom:0;">
            <div class="kpi-card">
              <div class="kpi-label">Risk Score</div>
              <div class="kpi-value" id="markovRiskScore" style="font-size:28px;">&mdash;</div>
              <div class="kpi-sub">Composite Markov risk</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-label">ETTC</div>
              <div class="kpi-value" id="markovETTC" style="font-size:28px;">&mdash;</div>
              <div class="kpi-sub">Expected time to critical</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-label">P(Critical) 20yr</div>
              <div class="kpi-value" id="markovPCrit" style="font-size:28px;">&mdash;</div>
              <div class="kpi-sub">Probability of reaching critical</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-label">Corrosion</div>
              <div class="kpi-value" id="markovCorrosion" style="font-size:28px;">&mdash;</div>
              <div class="kpi-sub">ISO 9223 classification</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       SECTION A: ESG RADAR CHART
       ══════════════════════════════════════════════════════════ -->
  <div class="section-block">
    <div class="section-header">
      <span class="section-number">A</span>
      <div class="section-title-group">
        <h2>ESG Radar &mdash; Six-Report Overview</h2>
        <div class="section-sub">Composite readiness across 6 ESG dimensions, each linked to UN Sustainable Development Goals</div>
      </div>
    </div>
    <div class="card" style="margin-bottom:24px; overflow:visible;">
      <div class="radar-wrap">
        <div class="radar-chart-box">
          <canvas id="esgRadar" width="500" height="420"></canvas>
        </div>
        <div class="radar-legend" id="radarLegend"></div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       SECTION B: INDIVIDUAL ESG REPORTS (dynamically rendered)
       ══════════════════════════════════════════════════════════ -->
  <div id="esgReportsContainer"></div>

  <!-- ══════════════════════════════════════════════════════════
       SECTION C: AUDIT TRAIL
       ══════════════════════════════════════════════════════════ -->
  <div class="section-block" id="audit">
    <div class="section-header">
      <span class="section-number">C</span>
      <div class="section-title-group">
        <h2>Audit Trail &amp; Methodology Note</h2>
        <div class="section-sub">Traceability for CSRD Article 29a limited assurance</div>
      </div>
    </div>
    <div class="card" style="margin-bottom:20px;">
      <table class="data-table">
        <thead><tr><th>Item</th><th>Value</th></tr></thead>
        <tbody id="auditTrailBody"></tbody>
      </table>
    </div>
  </div>

  <!-- ── Footer ── -->
  <div class="page-footer" id="footerContainer"></div>

</div><!-- /page-shell -->

{% set page = "esg-report" %}
{% set section_module_name = "esg-sections.js" %}
{% set skip_trailing_renderfooter = true %}
{% include "_base/thin_shell_footer.j2" %}
