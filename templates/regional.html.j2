{# templates/regional.html.j2 — Phase 3 Level C template for regional.html (v2 full overrides)
   Generated by scripts/build_pages.py from this template + templates/configs/<slug>.yaml.
   Output: <slug>/regional.html (39 files, one per country).

   Variables consumed from config:
     - slug, country_name, country_possessive, fleet_count
     - admin.count, admin.level_label_singular, admin.level_label_plural
     - descriptions.regional   (meta-tag string)
     - regional.subheader      (paragraph under H1 — required if no custom_header_html)
     - regional.custom_header_html (optional — full HTML block replacing standard <h1>+<p>;
                                    used for Colombia-style flag-prefixed headers and
                                    extra narrative blocks)

   Override slots (each falls back to a sensible default if absent):
     - regional.ranking_tab_label      → "Regional Ranking"
     - regional.compare_tab_label      → "<singular> Comparison"
     - regional.ranking_header         → "<plural> Ranked by Median R Score"
     - regional.ranking_count_text     → "<N> <plural> · sorted worst → best"
     - regional.ranking_column_header  → <singular>
     - regional.compare_select_h3      → "Select <plural> to Compare"
     - regional.compare_a_label        → "<singular> A"
     - regional.compare_b_label        → "<singular> B"
     - regional.compare_empty_text     → "Select <plural> above"
     - regional.decomp_header          → "Average Component Contribution by <singular>"
     - regional.decomp_subtext         → "Stacked horizontal bars · <N> <plural>"

   Reserved DOM IDs (renderer.js compatibility — DO NOT CHANGE):
     - #tab-ranking, #tab-compare, #tab-decomp
     - #ranking-count, #ranking-tbody
     - #prov-a, #prov-b, #th-prov-a, #th-prov-b, #compare-tbody, #compare-table
     - #radar-container, #radar-svg, #radar-legend
     - #decomp-bars
#}
<!DOCTYPE html>
<html lang="en">
{% if regional.page_title_override is defined and regional.page_title_override %}
{% set page_title = regional.page_title_override %}
{% else %}
{% set page_title = "SSI Index — Regional Analysis" %}
{% endif %}
{% set page_description = descriptions.regional %}
{% set page_specific_styles = "" %}
{% include "_base/head.j2" %}
<body>
{% set page = "regional" %}
{% include "_base/page_scripts.j2" %}

{# Derived labels (with optional overrides) — defaults computed from admin labels #}
{% set _sing = admin.level_label_singular %}
{% set _plur = admin.level_label_plural %}
{% set ranking_tab    = regional.ranking_tab_label     | default("Regional Ranking") %}
{% set compare_tab    = regional.compare_tab_label     | default(_sing ~ " Comparison") %}
{% set ranking_header = regional.ranking_header        | default(_plur ~ " Ranked by Median R Score") %}
{% set ranking_count  = regional.ranking_count_text    | default(admin.count ~ " " ~ _plur ~ " · sorted worst → best") %}
{% set ranking_col    = regional.ranking_column_header | default(_sing) %}
{% set compare_h3     = regional.compare_select_h3     | default("Select " ~ _plur ~ " to Compare") %}
{% set compare_a      = regional.compare_a_label       | default(_sing ~ " A") %}
{% set compare_b      = regional.compare_b_label       | default(_sing ~ " B") %}
{% set compare_empty  = regional.compare_empty_text    | default("Select " ~ _plur ~ " above") %}
{% set decomp_header  = regional.decomp_header         | default("Average Component Contribution by " ~ _sing) %}
{% set decomp_subtext = regional.decomp_subtext        | default("Stacked horizontal bars · " ~ admin.count ~ " " ~ _plur) %}

<main class="page-shell">
  <div class="page-header animate-in">
{% if regional.custom_header_html is defined and regional.custom_header_html %}
    {{ regional.custom_header_html | safe }}
{% else %}
    <h1>Regional Analysis</h1>
    <p>{{ regional.subheader }}</p>
{% endif %}
  </div>

  <!-- Tabs -->
  <div class="tabs animate-in delay-1">
    <button class="tab-btn active" onclick="switchTab(this,'tab-ranking')">{{ ranking_tab }}</button>
    <button class="tab-btn" onclick="switchTab(this,'tab-compare')">{{ compare_tab }}</button>
    <button class="tab-btn" onclick="switchTab(this,'tab-decomp')">Component Decomposition</button>
  </div>

  <!-- Tab: Regional Ranking -->
  <div id="tab-ranking">
    <div class="card animate-in delay-2" style="margin-bottom:24px">
      <div class="card-header">
        <h3>{{ ranking_header }}</h3>
        <span class="label-xs" id="ranking-count">{{ ranking_count }}</span>
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th style="width:30px">#</th>
            <th>{{ ranking_col }}</th>
            <th style="text-align:right">Median R</th>
            <th style="text-align:right">Substations</th>
            <th style="text-align:right">% Critical</th>
            <th style="text-align:right">% High</th>
            <th>Distribution</th>
          </tr>
        </thead>
        <tbody id="ranking-tbody">
          <tr><td colspan="7" style="text-align:center;color:var(--warm-grey);padding:32px"><div class="loading-spinner"></div> Loading data&hellip;</td></tr>
        </tbody>
      </table>
    </div>
{% if regional.ranking_tab_extra_html is defined and regional.ranking_tab_extra_html %}

    {{ regional.ranking_tab_extra_html | safe }}
{% endif %}
  </div>

  <!-- Tab: {{ compare_tab }} -->
  <div id="tab-compare" style="display:none">
    <div class="grid-2" style="margin-bottom:24px">
      <div class="card">
        <div class="card-header"><h3>{{ compare_h3 }}</h3></div>
        <div style="display:flex;gap:12px;margin-bottom:16px">
          <div style="flex:1">
            <div class="label-xs" style="margin-bottom:6px">{{ compare_a }}</div>
            <select id="prov-a" style="width:100%;font-family:'DM Sans',sans-serif;font-size:13px;padding:8px 10px;border:1px solid rgba(44,36,32,0.12);border-radius:6px;background:var(--cream)">
            </select>
          </div>
          <div style="flex:1">
            <div class="label-xs" style="margin-bottom:6px">{{ compare_b }}</div>
            <select id="prov-b" style="width:100%;font-family:'DM Sans',sans-serif;font-size:13px;padding:8px 10px;border:1px solid rgba(44,36,32,0.12);border-radius:6px;background:var(--cream)">
            </select>
          </div>
        </div>
        <!-- Comparison Table -->
        <table class="data-table" id="compare-table">
          <thead>
            <tr><th>Metric</th><th style="text-align:right" id="th-prov-a">&mdash;</th><th style="text-align:right" id="th-prov-b">&mdash;</th><th style="text-align:right">Delta</th></tr>
          </thead>
          <tbody id="compare-tbody">
            <tr><td colspan="4" style="text-align:center;color:var(--warm-grey);padding:24px">{{ compare_empty }}</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Radar Chart -->
      <div class="card" style="display:flex;flex-direction:column">
        <div class="card-header"><h3>Component Radar</h3></div>
        <div id="radar-container" style="display:flex;flex-direction:column;align-items:center;color:var(--warm-grey);flex:1;min-height:0">
          <div style="flex:1;display:flex;align-items:center;justify-content:center;min-height:0">
            <svg id="radar-svg" width="320" height="300" viewBox="0 0 280 260"></svg>
          </div>
          <div id="radar-legend" style="display:flex;flex-direction:column;align-items:center;font-size:11px;padding-bottom:0px;margin-top:0px"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab: Component Decomposition -->
  <div id="tab-decomp" style="display:none">
    <div class="card animate-in">
      <div class="card-header">
        <h3>{{ decomp_header }}</h3>
        <span class="label-xs">{{ decomp_subtext }}</span>
      </div>
      <div id="decomp-bars" style="margin-top:16px">
        <div style="text-align:center;color:var(--warm-grey);padding:32px"><div class="loading-spinner"></div> Loading data&hellip;</div>
      </div>
      <div style="display:flex;gap:14px;margin-top:16px;padding-top:12px;border-top:1px solid var(--card-border);font-size:11px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:5px"><div style="width:12px;height:8px;background:var(--crimson);border-radius:2px"></div>C Continuity</div>
        <div style="display:flex;align-items:center;gap:5px"><div style="width:12px;height:8px;background:var(--terracotta);border-radius:2px"></div>V Voltage</div>
        <div style="display:flex;align-items:center;gap:5px"><div style="width:12px;height:8px;background:var(--sage);border-radius:2px"></div>I Infrastructure</div>
        <div style="display:flex;align-items:center;gap:5px"><div style="width:12px;height:8px;background:#3b9eff;border-radius:2px"></div>E Economic</div>
        <div style="display:flex;align-items:center;gap:5px"><div style="width:12px;height:8px;background:var(--bronze);border-radius:2px"></div>S Saturation</div>
        <div style="display:flex;align-items:center;gap:5px"><div style="width:12px;height:8px;background:#22d3ee;border-radius:2px"></div>T Transition</div>
      </div>
    </div>
  </div>
</main>

<!-- ═══════════════════════════════════════════════════════════
     TAB SWITCHING — light inline helper (no data dependency)
     ═══════════════════════════════════════════════════════════ -->
<script>
function switchTab(btn, tabId) {
  document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('[id^="tab-"]').forEach(function(t) { t.style.display = 'none'; });
  document.getElementById(tabId).style.display = 'block';
}
renderFooter();
</script>

{% set section_module_name = "regional-sections.js" %}
{% set skip_trailing_renderfooter = true %}
{% include "_base/thin_shell_footer.j2" %}
</body>
</html>
