{# Map-page-specific CSS — extracted from current map.html lines 10-134.
   Identical across all 39 countries; isolated here for one-place maintenance. #}
  .map-container {
    position: relative;
    width: 100%;
    height: 620px;
    background: var(--cream-deep);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .map-container canvas {
    display: block;
    cursor: grab;
    width: 100%;
    height: 100%;
  }
  .map-container canvas.grabbing { cursor: grabbing; }

  #map-tooltip {
    position: absolute;
    pointer-events: none;
    background: rgba(250,246,245,0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(44,36,32,0.12);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    color: var(--ink);
    z-index: 200;
    display: none;
    max-width: 260px;
    box-shadow: 0 4px 16px rgba(44,36,32,0.1);
    line-height: 1.5;
  }

  .map-legend {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(250,246,245,0.92);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(44,36,32,0.1);
    border-radius: 10px;
    padding: 10px 14px;
    z-index: 10;
    box-shadow: 0 2px 12px rgba(44,36,32,0.06);
  }
  .map-legend h4 {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--warm-grey);
    margin-bottom: 6px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
  }
  .map-legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 3px;
    font-size: 11px;
  }

  .map-zoom {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 3px;
    z-index: 10;
  }
  .map-zoom button {
    width: 34px;
    height: 34px;
    background: rgba(250,246,245,0.92);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(44,36,32,0.1);
    border-radius: 7px;
    color: var(--ink);
    font-size: 17px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(44,36,32,0.06);
  }
  .map-zoom button:hover { background: var(--cream); }

  .map-stats {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(250,246,245,0.92);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(44,36,32,0.1);
    border-radius: 8px;
    padding: 8px 12px;
    z-index: 10;
    font-size: 11px;
    color: var(--warm-grey);
    letter-spacing: 0.02em;
  }
  .map-stats b { color: var(--ink); font-weight: 500; }

  .detail-scroll {
    max-height: 620px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(44,36,32,0.15) transparent;
  }
  .detail-scroll::-webkit-scrollbar { width: 5px; }
  .detail-scroll::-webkit-scrollbar-thumb { background: rgba(44,36,32,0.15); border-radius: 3px; }

  #btn-breakdown:hover {
    background: rgba(170,66,52,0.10) !important;
    border-color: rgba(170,66,52,0.25) !important;
  }

  @media (max-width: 1100px) {
    .map-layout { grid-template-columns: 1fr !important; }
    .map-container { height: 450px; }
    .detail-scroll { max-height: none; }
  }
